# Docker Compose settings. Copy to .env and fill in real values:
#   cp .env.example .env
# docker-compose.yml reads every value below; nothing secret lives in that file.
# To deploy elsewhere (another machine, Azure), change only this file.

# ---------- Public URLs (as seen from the user's browser) ----------
# Where the frontend is served. The API only accepts requests from this origin (CORS).
CLIENT_URL=http://localhost:5173
# Where the browser reaches the API. Must end with /api.
VITE_API_BASE_URL=http://localhost:5000/api

# ---------- Host ports (change if something else already uses them) ----------
CLIENT_HOST_PORT=5173
SERVER_HOST_PORT=5000
# 3307 avoids clashing with a locally installed MySQL on 3306.
MYSQL_HOST_PORT=3307

# ---------- Database ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
# database/init.sql and seed.sql run "USE app_db;" - keep DB_NAME=app_db unless you edit those too.
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=change_me_db_password

# ---------- Auth ----------
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30

# ---------- Email (Mailtrap, used for password reset) ----------
MAILTRAP_API_TOKEN=your_mailtrap_api_token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=No Reply
