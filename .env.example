# URL where users open the app (CORS and reset links)
CLIENT_URL=http://localhost:8080

# API path used by the browser
VITE_API_BASE_URL=/api

# Port where the app is opened
APP_PORT=8080

# MySQL root password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Database name (must match database/init.sql)
DB_NAME=app_db

# Database user
DB_USER=app_user

# Database user password
DB_PASSWORD=change_me_db_password

# Secret key for signing login tokens
JWT_SECRET=change_me_to_a_long_random_secret

# Login token lifetime
JWT_EXPIRES_IN=1d

# Password reset link lifetime in minutes
RESET_TOKEN_EXPIRES_MINUTES=30

# Mailtrap API token for sending emails
MAILTRAP_API_TOKEN=your_mailtrap_api_token

# Sender email address
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co

# Sender display name
MAILTRAP_SENDER_NAME=No Reply
