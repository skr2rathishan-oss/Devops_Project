# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
# Only needed if connecting to a MySQL host that requires TLS (e.g. a managed cloud DB)
DB_SSL=false
DB_SSL_CA=

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30

# Email (Mailtrap for password reset)
MAILTRAP_API_TOKEN=your_mailtrap_api_token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=No Reply
